{
  "name": "@jiumate/cli",
  "version": "0.4.0",
  "type": "module",
  "description": "JiuMate CLI: interactive REPL and single-task runner over @jiumate/core.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiaiqian67/jiumate.git",
    "directory": "packages/cli"
  },
  "bin": {
    "jiumate": "./dist/jiumate.js",
    "jiumate-hmr": "./dist/jiumate-hmr.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "build": "tsup",
    "jiumate": "node ../../scripts/run-with-env.mjs JIUMATE_HOME=~/.jiumate/dev-data-cli PORT=7369 -- tsx src/jiumate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@jiumate/a2ui": "workspace:*",
    "@jiumate/ace-rsi-toolkit": "workspace:*",
    "@jiumate/agent-development": "workspace:*",
    "@jiumate/ape-rsi-toolkit": "workspace:*",
    "@jiumate/awm-rsi-toolkit": "workspace:*",
    "@jiumate/browser-automation": "workspace:*",
    "@jiumate/agent-tuning": "workspace:*",
    "@jiumate/continual-learning": "workspace:*",
    "@jiumate/data-analysis": "workspace:*",
    "@jiumate/goal": "workspace:*",
    "@jiumate/humanizer": "workspace:*",
    "@jiumate/model-development": "workspace:*",
    "@jiumate/opro-rsi-toolkit": "workspace:*",
    "@jiumate/skill-porting": "workspace:*",
    "@jiumate/software-development": "workspace:*",
    "@jiumate/use-bento-slides": "workspace:*",
    "@jiumate/use-firecrawl": "workspace:*",
    "@jiumate/use-claude-code": "workspace:*",
    "@prismshadow/agenthub": "^0.4.9",
    "@jiumate/core": "workspace:*",
    "@jiumate/server": "workspace:*",
    "commander": "^13.0.0",
    "dotenv": "^17.0.0",
    "smol-toml": "^1.3.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
