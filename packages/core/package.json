{
  "name": "@jiumate/core",
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "JiuMate core SDK: context_engine, OmniMessage protocol, LLM/Environment interfaces.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiaiqian67/jiumate.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./omnimessage": {
      "types": "./dist/omnimessage/index.d.ts",
      "import": "./dist/omnimessage/index.js"
    },
    "./markers": {
      "types": "./dist/omnimessage/markers/index.d.ts",
      "import": "./dist/omnimessage/markers/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "import": "./dist/extension/index.js"
    },
    "./documents": {
      "types": "./dist/documents/index.d.ts",
      "import": "./dist/documents/index.js",
      "default": "./dist/documents/index.js"
    },
    "./model-catalog": {
      "types": "./dist/state/model-catalog.d.ts",
      "import": "./dist/state/model-catalog.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "default": "./dist/kernel/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js",
      "default": "./dist/browser/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "node ../../scripts/run-with-env.mjs JIUMATE_E2E=1 -- vitest run test/llm.e2e.test.ts",
    "build": "tsup"
  },
  "dependencies": {
    "@jiumate/a2ui": "workspace:*",
    "@jiumate/ace-rsi-toolkit": "workspace:*",
    "@jiumate/agent-development": "workspace:*",
    "@jiumate/agent-tuning": "workspace:*",
    "@jiumate/ape-rsi-toolkit": "workspace:*",
    "@jiumate/awm-rsi-toolkit": "workspace:*",
    "@jiumate/browser-automation": "workspace:*",
    "@jiumate/continual-learning": "workspace:*",
    "@jiumate/data-analysis": "workspace:*",
    "@jiumate/goal": "workspace:*",
    "@jiumate/humanizer": "workspace:*",
    "@jiumate/model-development": "workspace:*",
    "@jiumate/opro-rsi-toolkit": "workspace:*",
    "@jiumate/skill-porting": "workspace:*",
    "@jiumate/software-development": "workspace:*",
    "@jiumate/use-bento-slides": "workspace:*",
    "@jiumate/use-claude-code": "workspace:*",
    "@jiumate/use-firecrawl": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@prismshadow/agenthub": "^0.4.9",
    "arktype": "^2.2.3",
    "docx": "^9.7.1",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "mammoth": "^1.12.3",
    "marked": "^18.0.14",
    "pdfjs-dist": "^6.3.289",
    "read-excel-file": "^9.3.10",
    "smol-toml": "^1.3.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.6",
    "dotenv": "^17.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6",
    "zod": "^4.2.0"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
