{
  "name": "@jadelau/desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "JiuMate desktop app: Electron shell running @jadelau/server as a utilityProcess, window on http://localhost (same-origin HTTP/SSE, no private IPC).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup && tsup --config tsup.preload.config.ts && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "node scripts/preflight.mjs && electron .",
    "pack": "node scripts/preflight.mjs && electron-builder",
    "pack:linux": "node scripts/preflight.mjs && electron-builder --linux",
    "pack:mac": "node scripts/preflight.mjs && electron-builder --mac",
    "pack:win": "node scripts/preflight.mjs && electron-builder --win"
  },
  "dependencies": {
    "@jadelau/a2ui": "workspace:*",
    "@jadelau/ace-rsi-toolkit": "workspace:*",
    "@jadelau/agent-development": "workspace:*",
    "@jadelau/ape-rsi-toolkit": "workspace:*",
    "@jadelau/awm-rsi-toolkit": "workspace:*",
    "@jadelau/browser-automation": "workspace:*",
    "@jadelau/agent-tuning": "workspace:*",
    "@jadelau/continual-learning": "workspace:*",
    "@jadelau/data-analysis": "workspace:*",
    "@jadelau/goal": "workspace:*",
    "@jadelau/humanizer": "workspace:*",
    "@jadelau/model-development": "workspace:*",
    "@jadelau/opro-rsi-toolkit": "workspace:*",
    "@jadelau/skill-porting": "workspace:*",
    "@jadelau/software-development": "workspace:*",
    "@jadelau/use-bento-slides": "workspace:*",
    "@jadelau/use-firecrawl": "workspace:*",
    "@jadelau/use-claude-code": "workspace:*"
  },
  "devDependencies": {
    "@jadelau/cli": "workspace:*",
    "@jadelau/core": "workspace:*",
    "@jadelau/server": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
