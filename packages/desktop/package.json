{
  "name": "@prismshadow/jiumate-desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "JiuMate desktop app: Electron shell running @prismshadow/jiumate-server as a utilityProcess, window on http://localhost (same-origin HTTP/SSE, no private IPC).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup && tsup --config tsup.preload.config.ts && node scripts/build-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "node scripts/preflight.mjs && electron .",
    "pack": "node scripts/preflight.mjs && electron-builder",
    "pack:linux": "node scripts/preflight.mjs && electron-builder --linux",
    "pack:mac": "node scripts/preflight.mjs && electron-builder --mac",
    "pack:win": "node scripts/preflight.mjs && electron-builder --win"
  },
  "dependencies": {
    "@jiumate/a2ui": "workspace:*",
    "@jiumate/ace-rsi-toolkit": "workspace:*",
    "@jiumate/agent-development": "workspace:*",
    "@jiumate/ape-rsi-toolkit": "workspace:*",
    "@jiumate/awm-rsi-toolkit": "workspace:*",
    "@jiumate/browser-automation": "workspace:*",
    "@jiumate/agent-tuning": "workspace:*",
    "@jiumate/continual-learning": "workspace:*",
    "@jiumate/data-analysis": "workspace:*",
    "@jiumate/goal": "workspace:*",
    "@jiumate/humanizer": "workspace:*",
    "@jiumate/model-development": "workspace:*",
    "@jiumate/opro-rsi-toolkit": "workspace:*",
    "@jiumate/skill-porting": "workspace:*",
    "@jiumate/software-development": "workspace:*",
    "@jiumate/use-bento-slides": "workspace:*",
    "@jiumate/use-firecrawl": "workspace:*",
    "@jiumate/use-claude-code": "workspace:*"
  },
  "devDependencies": {
    "@prismshadow/jiumate-cli": "workspace:*",
    "@prismshadow/jiumate-core": "workspace:*",
    "@prismshadow/jiumate-server": "workspace:*",
    "@types/node": "^24.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
