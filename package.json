{
  "name": "linsight",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Linsight — TypeScript AI Agent (SDK + CLI).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "check:licenses": "node scripts/check-licenses.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @prismshadow/linsight-core test:e2e",
    "build": "pnpm -r build && pnpm link:cli",
    "link:cli": "pnpm --dir packages/cli link --global || echo '[link:cli] pnpm global directory not configured; skipping the global linsight link (run pnpm setup once first)'",
    "linsight": "node scripts/run-with-env.mjs LINSIGHT_HOME=~/.linsight/dev-data-cli PORT=7369 -- tsx packages/cli/src/linsight.ts",
    "dev": "concurrently -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @prismshadow/linsight-server dev",
    "dev:web": "node scripts/dev-prebuild.mjs && pnpm --filter @prismshadow/linsight-web dev",
    "dev:docs": "node scripts/dev-prebuild.mjs --install-only && pnpm --filter @prismshadow/linsight-docs dev",
    "dev:landing": "node scripts/dev-prebuild.mjs --install-only && pnpm --filter @prismshadow/linsight-landing dev",
    "build:site": "node scripts/build-site.mjs",
    "desktop": "pnpm -r build && node scripts/run-with-env.mjs LINSIGHT_HOME=~/.linsight/dev-data -- pnpm --dir packages/desktop start"
  },
  "devDependencies": {
    "@prismshadow/linsight-cli": "workspace:*",
    "@prismshadow/linsight-core": "workspace:*",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "esbuild": "^0.28.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.4",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@11.18.0"
}
