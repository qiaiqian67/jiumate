.DS_Store

# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# `pnpm pack` in a package drops the tarball in that package's root, next to package.json
# rather than under dist/. Nothing consumes it and it is 200MB+.
*.tgz
# web assets copied into the server package at npm publish time
packages/server/web-dist/

# secrets / local config
.env
.env.*
!.env.example

# agenthub trace cache
cache/

# legacy .jiumate workspace symlink (no longer created; ignored for old working copies)
.jiumate

# logs
*.log

# Agent workspace. `.claude` is a committed symlink to `.agents`, so a
# Claude Code session and any other agent read the same `.agents/skills/`.
# The shared contents are tracked; only per-machine session state is not.
.agents/settings.local.json
.agents/**/*.local.*

# Per-package Claude Code session state (auto-handoff observation logs).
# These are emitted by a session and are not shareable across machines.
packages/*/.claude/

# playwright e2e artifacts
packages/web/test-results/
packages/web/playwright-report/

# blog images staged locally by the landing capture/render scripts before they are
# published — never committed here
packages/landing/.blog-assets/

# local design-doc symlink and agent instructions
/design
/AGENTS.md
/CLAUDE.md

# Playwright screenshots from the render test: regenerated on every run, not source.
packages/web/test-output/
